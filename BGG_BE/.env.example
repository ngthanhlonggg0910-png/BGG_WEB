DB_SERVER=host.docker.internal
DB_PORT=1433
DB_USER=your_user
DB_PASSWORD=your_password
DB_DATABASE=your_database
DB_ENCRYPT=false
DB_TRUST_CERT=true
PASSWORD_SECRET_KEY=your_existing_password_secret

# Login token (Bearer) required by every /api route except /auth/login and /push/*.
# Recommended: a separate long random value; otherwise PASSWORD_SECRET_KEY is used.
# Changing it logs every user out.
AUTH_TOKEN_SECRET=
# How long a login stays valid, in hours (default 24).
AUTH_TOKEN_TTL_HOURS=24
# Optional comma-separated origins allowed to call the API cross-origin.
# Not needed behind the bundled nginx or the Vite dev proxy (same origin).
CORS_ORIGINS=

# Web Push: run npm run push:setup BEFORE setting PUSH_ENABLED=true.
PUSH_ENABLED=false
VAPID_SUBJECT=mailto:admin@yourdomain.vn
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional separate signing secret; otherwise PASSWORD_SECRET_KEY is used.
PUSH_AUTH_SECRET=
# Optional comma-separated TKId list allowed to edit recipient selection.
# Empty: any authenticated account can manage recipients (existing app has no roles).
PUSH_MANAGE_TK_IDS=

# Thư mục chứa tài liệu kỹ thuật (Phòng kỹ thuật xem PDF/Word/Excel).
# Để trống thì dùng thư mục dùng chung \\192.168.1.5\uploads\PhieuDieuTiet\Uploads\TaiLieuKyThuat
# Tài khoản chạy backend (Windows service/IIS) phải có quyền đọc thư mục này.
TECHNICAL_DOCUMENT_FOLDER_PATH=

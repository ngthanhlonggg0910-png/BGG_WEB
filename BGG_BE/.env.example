DB_SERVER=host.docker.internal
DB_PORT=1433
DB_USER=your_user
DB_PASSWORD=your_password
DB_DATABASE=your_database
DB_ENCRYPT=false
DB_TRUST_CERT=true
PASSWORD_SECRET_KEY=your_existing_password_secret

# Web Push: run npm run push:setup BEFORE setting PUSH_ENABLED=true.
PUSH_ENABLED=false
VAPID_SUBJECT=mailto:admin@yourdomain.vn
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional separate signing secret; otherwise PASSWORD_SECRET_KEY is used.
PUSH_AUTH_SECRET=
# Optional comma-separated TKId list allowed to edit recipient selection.
# Empty: any authenticated account can manage recipients (existing app has no roles).
PUSH_MANAGE_TK_IDS=
